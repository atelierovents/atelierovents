---
import Layout from '../components/Layout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'accueil');
const { title, subtitle } = entry.data;
const { Content } = await entry.render();
---

<Layout title={title} description={subtitle}>
  <!-- Bandeau d'accueil : titre et sous-titre viennent de l'admin -->
  <section class="max-w-5xl mx-auto px-4 pt-20 pb-12 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-stone-900 mb-4">
      {title}
    </h1>
    <p class="text-xl text-stone-600">
      {subtitle}
    </p>
  </section>

  <!-- Corps de la page, entièrement rédigé depuis l'admin (Decap).
       Les titres de section, paragraphes, listes, liens et images insérés
       dans l'éditeur Markdown atterrissent tous ici. -->
  <section class="max-w-3xl mx-auto px-4 pb-12 prose prose-stone lg:prose-lg">
    <Content />
  </section>

  <!-- Raccourcis de navigation : structure du site, pas du contenu -->
  <section class="max-w-5xl mx-auto px-4 pb-16 flex flex-col sm:flex-row gap-4 justify-center">
    <a href="/atelier" class="bg-amber-700 text-white px-6 py-3 rounded-lg hover:bg-amber-800 transition font-medium text-center">
      Découvrir l'atelier
    </a>
    <a href="/occasions" class="border border-amber-700 text-amber-800 px-6 py-3 rounded-lg hover:bg-amber-50 transition font-medium text-center">
      Voir les instruments
    </a>
  </section>

  <!-- Section Contact -->
  <section class="max-w-5xl mx-auto px-4 py-12 text-center border-t border-stone-200">
    <p class="text-stone-600">
      Une question ? <a href="/contact" class="text-amber-700 hover:underline font-medium">Contactez-nous</a>
    </p>
  </section>
</Layout>
