---
import Layout from '../components/Layout.astro';
---

<Layout title="Accueil">
  <section class="max-w-5xl mx-auto px-4 py-20 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-stone-900 mb-6">
      Réparation d'instruments à vent
    </h1>
    <p class="text-lg text-stone-600 max-w-2xl mx-auto mb-10">
      Saxophones, clarinettes, flûtes, trompettes… Un atelier artisanal au service de votre instrument.
    </p>
    <div class="flex gap-4 justify-center">
      <a href="/atelier" class="bg-amber-700 text-white px-6 py-3 rounded-lg hover:bg-amber-800 transition">
        Découvrir l'atelier
      </a>
      <a href="/contact" class="border border-stone-300 px-6 py-3 rounded-lg hover:bg-stone-100 transition">
        Nous contacter
      </a>
    </div>
  </section>
</Layout>
