---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection, getEntry } from 'astro:content';
import { instrumentSlugs } from '../lib/instrument-slug';

const entry = await getEntry('pages', 'occasions');
const { title, subtitle, tagline } = entry.data;
const { Content } = await entry.render();

const all = await getCollection('occasions');
// Les adresses se calculent sur la collection complète : une fiche vendue et
// une fiche disponible portant le même nom doivent obtenir le même suffixe ici
// et dans les routes.
const slugs = instrumentSlugs(all);
const instruments = all.filter((instrument) => instrument.data.vendu !== true);
---

<Layout title={title} description={subtitle || tagline}>
  <PageHeader title={title} tagline={tagline} />

  <!-- Introduction de la page, rédigée depuis l'admin (Decap).
       Les fiches ci-dessous, elles, viennent de la collection « occasions ». -->
  <section class="max-w-3xl mx-auto px-4 pb-12 prose">
    <Content />
  </section>

  <section class="max-w-5xl mx-auto px-4 pb-16">
    {instruments.length === 0 ? (
      <p class="text-center text-stone-500">Aucun instrument disponible pour le moment.</p>
    ) : (
      <div class="grid md:grid-cols-2 gap-8">
        {instruments.map((instrument) => (
          <a href={`/occasions/${slugs.get(instrument.id)}`} class="block bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
            {instrument.data.photo && (
              <img src={instrument.data.photo} alt={instrument.data.title} class="w-full aspect-[4/3] object-cover" />
            )}
            <div class="p-6">
              <h2 class="text-xl font-bold text-brand mb-1">{instrument.data.title}</h2>
              <div class="flex items-center gap-4 text-sm">
                {instrument.data.prix && (
                  <span class="font-semibold text-gold-dark">{instrument.data.prix} €</span>
                )}
                {instrument.data.etat && (
                  <span class="text-stone-500">{instrument.data.etat}</span>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>
