---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getEntry } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

const main = await getEntry('pages', 'atelier');
const { title, subtitle, tagline, bois, cuivres } = main.data;
const { Content: MainContent } = await main.render();

// Les blocs Bois et Cuivres sont désormais des champs de la page : un seul écran
// dans l'admin. Leur contenu reste du Markdown, rendu avec le processeur d'Astro
// pour hériter des mêmes styles que le reste du site.
const markdown = await createMarkdownProcessor();
const toHtml = async (value?: string) => (value ? (await markdown.render(value)).code : '');
const boisHtml = await toHtml(bois?.body);
const cuivresHtml = await toHtml(cuivres?.body);
---

<Layout title={title} description={subtitle || tagline}>
  <PageHeader title={title} tagline={tagline} />

  <!-- Introduction -->
  <section class="max-w-3xl mx-auto px-4 pb-12 text-center">
    <div class="prose mx-auto">
      <MainContent />
    </div>
  </section>

  <!-- Deux cartes : Bois et Cuivres -->
  <section class="max-w-5xl mx-auto px-4 pb-16 grid md:grid-cols-2 gap-8">
    {bois && (
      <div class="bg-white rounded-lg shadow-md overflow-hidden">
        {bois.photo && (
          <img src={bois.photo} alt={bois.photoAlt ?? ''} class="w-full h-48 object-cover" />
        )}
        <div class="p-6">
          <h2 class="text-2xl font-bold text-brand mb-1">{bois.title}</h2>
          {bois.subtitle && <p class="text-sm text-stone-500 mb-4">{bois.subtitle}</p>}
          <div class="prose prose-sm" set:html={boisHtml} />
        </div>
      </div>
    )}

    {cuivres && (
      <div class="bg-white rounded-lg shadow-md overflow-hidden">
        {cuivres.photo && (
          <img src={cuivres.photo} alt={cuivres.photoAlt ?? ''} class="w-full h-48 object-cover" />
        )}
        <div class="p-6">
          <h2 class="text-2xl font-bold text-brand mb-1">{cuivres.title}</h2>
          {cuivres.subtitle && <p class="text-sm text-stone-500 mb-4">{cuivres.subtitle}</p>}
          <div class="prose prose-sm" set:html={cuivresHtml} />
        </div>
      </div>
    )}
  </section>

  <!-- Appel à l'action -->
  <section class="max-w-5xl mx-auto px-4 pb-16 text-center">
    <a href="/contact" class="bg-brand text-white px-6 py-3 rounded-lg hover:bg-brand-dark transition font-medium">
      Demander un devis
    </a>
  </section>
</Layout>
