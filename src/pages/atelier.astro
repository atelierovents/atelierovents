---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getEntry } from 'astro:content';

const main = await getEntry('pages', 'atelier');
const bois = await getEntry('pages', 'atelier-bois');
const cuivres = await getEntry('pages', 'atelier-cuivres');

const { title, subtitle, tagline } = main.data;
const { Content: MainContent } = await main.render();
const { Content: BoisContent } = await bois.render();
const { Content: CuivresContent } = await cuivres.render();
---

<Layout title={title} description={subtitle}>
  <PageHeader title={title} tagline={tagline} />

  <!-- Introduction -->
  <section class="max-w-3xl mx-auto px-4 pb-12 text-center">
    <div class="prose mx-auto">
      <MainContent />
    </div>
  </section>

  <!-- Deux cartes : Bois et Cuivres -->
  <section class="max-w-5xl mx-auto px-4 pb-16 grid md:grid-cols-2 gap-8">
    <!-- Carte Bois -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <img src="/images/bois.jpg" alt="Instruments à vent en bois" class="w-full h-48 object-cover" />
      <div class="p-6">
        <h2 class="text-2xl font-bold text-brand mb-1">{bois.data.title}</h2>
        <p class="text-sm text-stone-500 mb-4">{bois.data.subtitle}</p>
        <div class="prose prose-sm">
          <BoisContent />
        </div>
      </div>
    </div>

    <!-- Carte Cuivres -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <img src="/images/cuivres.jpg" alt="Instruments à vent en cuivre" class="w-full h-48 object-cover" />
      <div class="p-6">
        <h2 class="text-2xl font-bold text-brand mb-1">{cuivres.data.title}</h2>
        <p class="text-sm text-stone-500 mb-4">{cuivres.data.subtitle}</p>
        <div class="prose prose-sm">
          <CuivresContent />
        </div>
      </div>
    </div>
  </section>

  <!-- Appel à l'action -->
  <section class="max-w-5xl mx-auto px-4 pb-16 text-center">
    <a href="/contact" class="bg-brand text-white px-6 py-3 rounded-lg hover:bg-brand-dark transition font-medium">
      Demander un devis
    </a>
  </section>
</Layout>
