---
import Layout from '../../components/Layout.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { getCollection, render } from 'astro:content';
import { instrumentSlugs } from '../../lib/instrument-slug';

export async function getStaticPaths() {
  const instruments = await getCollection('occasions');
  const slugs = instrumentSlugs(instruments);
  return instruments.map((instrument) => ({
    params: { slug: slugs.get(instrument.id) },
    props: { instrument },
  }));
}

const { instrument } = Astro.props;
const { title, prix, etat, photo, galerie } = instrument.data;
const { Content } = await render(instrument);

// La photo principale ouvre le carrousel, la galerie suit. L'admin écrit une
// simple liste de chemins ; les objets { image: … } restent acceptés pour ne
// pas dépendre de la forme exacte du widget.
const photos = [
  photo,
  ...(galerie ?? []).map((item) => (typeof item === 'string' ? item : item.image)),
].filter((src): src is string => Boolean(src));

---

<Layout title={title} description={`${title} — ${etat ?? ''}`}>
  <section class="max-w-3xl mx-auto px-4 py-16">
    <a href="/occasions" class="text-sm text-gold-dark hover:underline mb-6 inline-block">← Retour aux occasions</a>

    {photos.length > 0 && (
      <PhotoGallery photos={photos.map((src) => ({ src, alt: title }))} label={`Photos de ${title}`} />
    )}

    <h1 class="text-3xl font-bold text-brand mb-2">{title}</h1>

    <div class="flex items-center gap-4 mb-8">
      {prix && <span class="text-2xl font-semibold text-gold-dark">{prix} €</span>}
      {etat && <span class="text-stone-500">{etat}</span>}
    </div>

    <div class="prose mb-8">
      <Content />
    </div>

    <a href="/contact" class="bg-brand text-white px-6 py-3 rounded-lg hover:bg-brand-dark transition font-medium">
      Nous contacter pour cet instrument
    </a>
  </section>
</Layout>
