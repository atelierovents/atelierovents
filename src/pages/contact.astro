---
import Layout from '../components/Layout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'contact');
const { title } = entry.data;
const { Content } = await entry.render();
---

<Layout title="Contact" description="Contactez l'Atelier Ô Vents pour un devis ou une question.">
  <section class="max-w-5xl mx-auto px-4 py-16">
    <h1 class="text-3xl md:text-4xl font-bold text-stone-900 mb-4">Contact</h1>
    <p class="text-stone-600 mb-10 max-w-2xl">
      Une question, une demande particulière ? Laissez-nous votre message en remplissant le formulaire ci-dessous.
      Nous ferons de notre mieux pour vous répondre dans les plus brefs délais.
    </p>

    <!-- Formulaire de contact -->
    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="space-y-6 max-w-2xl mb-16"
    >
      <input type="hidden" name="access_key" value="29d1abbc-113b-4826-8fa2-e4f16a538d2e" />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

      <div>
        <label for="nom" class="block text-sm font-medium mb-1">Nom <span class="text-red-600">*</span></label>
        <input type="text" id="nom" name="nom" required class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-amber-600" />
      </div>

      <div>
        <label for="telephone" class="block text-sm font-medium mb-1">Téléphone <span class="text-stone-400 text-xs">(facultatif)</span></label>
        <input type="tel" id="telephone" name="telephone" class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-amber-600" />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium mb-1">E-mail <span class="text-red-600">*</span></label>
        <input type="email" id="email" name="email" required class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-amber-600" />
      </div>

      <div>
        <label for="sujet" class="block text-sm font-medium mb-1">Sujet <span class="text-red-600">*</span></label>
        <input type="text" id="sujet" name="sujet" required class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-amber-600" />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium mb-1">Message <span class="text-red-600">*</span></label>
        <textarea id="message" name="message" rows="6" required class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-amber-600"></textarea>
      </div>

      <input type="hidden" name="redirect" value="https://atelierovents.pages.dev/contact?envoye=1" />

      <button type="submit" class="bg-amber-700 text-white px-6 py-3 rounded-lg hover:bg-amber-800 transition font-medium">
        Envoyer le message
      </button>

      <p class="text-xs text-stone-500">Les champs marqués d'un <span class="text-red-600">*</span> sont obligatoires.</p>
    </form>

    <!-- Deux colonnes : coordonnées à gauche, carte à droite -->
    <div class="grid md:grid-cols-2 gap-8 items-start">
      <div>
        <h2 class="text-xl font-semibold mb-4">Coordonnées</h2>
        <address class="not-italic text-stone-700 space-y-2">
          <p><strong>Atelier O Vents</strong><br />
          15 avenue de la Tour<br />
          12330 Clairvaux-d'Aveyron</p>
          <p>Téléphone : <a href="tel:+33789843601" class="text-amber-700 hover:underline">07 89 84 36 01</a></p>
          <p>E-mail : <a href="mailto:contact@atelierovents.fr" class="text-amber-700 hover:underline">contact@atelierovents.fr</a></p>
        </address>
        <p class="mt-6 text-stone-600">
          <strong>Accueil uniquement sur rendez-vous</strong><br />
          Prise de rendez-vous par téléphone ou via le formulaire de contact.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold mb-4">Nous trouver</h2>
        <div class="rounded-lg overflow-hidden border border-stone-200">
          <iframe
            width="100%"
            height="300"
            frameborder="0"
            scrolling="no"
            marginheight="0"
            marginwidth="0"
            src="https://www.openstreetmap.org/export/embed.html?bbox=2.35%2C44.35%2C2.40%2C44.40&amp;layer=mapnik&amp;marker=44.375%2C2.375"
            style="border:0;"
            title="Carte de l'Atelier O Vents"
          ></iframe>
        </div>
        <p class="text-xs text-stone-500 mt-2">
          <a href="https://www.openstreetmap.org/?mlat=44.375&amp;mlon=2.375#map=15/44.375/2.375" target="_blank" rel="noopener" class="hover:underline">
            Voir la carte en plein écran
          </a>
        </p>
      </div>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    if (params.get('envoye') === '1') {
      const banner = document.createElement('div');
      banner.className = 'bg-green-100 text-green-800 border border-green-300 rounded-lg p-4 mb-6 max-w-2xl mx-auto';
      banner.textContent = 'Merci ! Votre message a bien été envoyé. Nous vous répondrons rapidement.';
      document.querySelector('section')?.prepend(banner);
    }
  </script>
</Layout>
