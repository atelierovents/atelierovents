---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'contact');
const { title, tagline } = entry.data;
const { Content } = await entry.render();

// Coordonnées de l'atelier, reprises de la carte affichée plus bas.
const lat = '44.4275280';
const lon = '2.4106785';
const phone = { label: '07 89 84 36 01', href: 'tel:+33789843601' };
---

<Layout title="Contact" description={tagline || "Contactez l'Atelier Ô Vents pour un devis ou une question."}>
  <PageHeader title={title} tagline={tagline} compact />

  <!-- Sur mobile, appeler est le geste le plus direct : un raccourci avant le
       formulaire, pour ne pas avoir à faire défiler les coordonnées. -->
  <div class="lg:hidden max-w-5xl mx-auto px-4 mb-10">
    <a
      href={phone.href}
      class="flex items-center justify-center gap-2 rounded-lg border border-stone-300 bg-white px-4 py-3 font-medium text-brand shadow-sm transition hover:border-brand/40"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
      </svg>
      Appeler l'atelier · {phone.label}
    </a>
  </div>

  <!-- Deux colonnes sur grand écran : le formulaire à gauche, les coordonnées
       à droite. Le formulaire vient d'abord dans le document, pour que l'ordre
       de lecture suive celui de l'écran sur mobile. -->
  <section class="max-w-5xl mx-auto px-4 pb-16 grid gap-10 lg:grid-cols-5 lg:items-start">
    <div class="lg:col-span-3">
      <!-- Confirmation affichée à la place du formulaire, sans changer de page. -->
      <div
        id="contact-success"
        role="status"
        tabindex="-1"
        class="hidden rounded-lg border border-green-300 bg-green-50 p-6 text-green-900"
      >
        <p class="font-semibold mb-1">Message envoyé.</p>
        <p class="text-sm">Merci, nous vous répondrons dans les plus brefs délais.</p>
      </div>

      <!-- Confirmation pour le visiteur sans JavaScript : Formdall le renvoie
           ici avec ?envoye=1 après un envoi classique. -->
      <div
        id="contact-sent"
        role="status"
        class="hidden rounded-lg border border-green-300 bg-green-50 p-6 text-green-900"
      >
        <p class="font-semibold mb-1">Message envoyé.</p>
        <p class="text-sm">Merci, nous vous répondrons dans les plus brefs délais.</p>
      </div>

      <form
        id="contact-form"
        action="https://api.formdall.de/api/v1/f/6spWIgyiUfDxttNMoU45awnbERbNA8yK1Mid4UGe"
        method="POST"
        class="space-y-6"
      >
        <!-- Piège à robots fourni par Formdall : invisible pour un visiteur,
             rempli par les scripts qui remplissent tout à l'aveugle. Le nom du
             champ est volontairement absent de leur documentation, ne pas le
             renommer. -->
        <input
          type="text"
          name="_url"
          tabindex="-1"
          autocomplete="off"
          style="position:absolute;left:-9999px"
          aria-hidden="true"
        />

        <div>
          <label for="nom" class="block text-sm font-medium mb-1">Nom <span class="text-red-600">*</span></label>
          <input type="text" id="nom" name="nom" autocomplete="name" required class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>

        <div>
          <label for="telephone" class="block text-sm font-medium mb-1">Téléphone <span class="text-stone-400 text-xs">(facultatif)</span></label>
          <input type="tel" id="telephone" name="telephone" autocomplete="tel" class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium mb-1">E-mail <span class="text-red-600">*</span></label>
          <input type="email" id="email" name="email" autocomplete="email" required class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>

        <div>
          <label for="sujet" class="block text-sm font-medium mb-1">Sujet <span class="text-red-600">*</span></label>
          <input type="text" id="sujet" name="sujet" required class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>

        <div>
          <label for="message" class="block text-sm font-medium mb-1">Message <span class="text-red-600">*</span></label>
          <textarea id="message" name="message" rows="6" required class="w-full border border-stone-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-brand"></textarea>
        </div>

        <div
          id="contact-error"
          role="alert"
          class="hidden rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-800"
        >
          L'envoi n'a pas abouti. Réessayez dans un instant, ou écrivez-nous directement à
          <a href="mailto:contact@atelierovents.fr" class="underline">contact@atelierovents.fr</a>.
        </div>

        <button type="submit" class="bg-brand text-white px-6 py-3 rounded-lg hover:bg-brand-dark transition font-medium disabled:opacity-60">
          Envoyer le message
        </button>

        <p class="text-xs text-stone-500 leading-relaxed">
          Les champs marqués d'un <span class="text-red-600">*</span> sont obligatoires.
          Vos informations servent uniquement à répondre à votre demande : voir la
          <a href="/confidentialite" class="underline hover:text-brand">politique de confidentialité</a>.
        </p>
      </form>
    </div>

    <aside class="lg:col-span-2 space-y-6">
      <div class="prose">
        <Content />
      </div>

      <div>
        <iframe
          src={`https://www.openstreetmap.org/export/embed.html?bbox=2.4056785%2C44.4255280%2C2.4156785%2C44.4295280&layer=mapnik&marker=${lat}%2C${lon}`}
          class="w-full h-56 rounded-lg shadow-sm border-0"
          title="Carte de localisation de l'atelier"
          loading="lazy"
        ></iframe>
        <a
          href={`https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=17/${lat}/${lon}`}
          target="_blank"
          rel="noopener"
          class="mt-2 inline-block text-sm text-gold-dark hover:underline"
        >
          Ouvrir la carte et l'itinéraire →
        </a>
      </div>
    </aside>
  </section>

  <script>
    // Retour d'un envoi classique (JavaScript désactivé) : Formdall redirige
    // vers cette page avec ?envoye=1.
    if (new URLSearchParams(window.location.search).get('envoye') === '1') {
      document.querySelector('#contact-sent')?.classList.remove('hidden');
      document.querySelector('#contact-form')?.classList.add('hidden');
    }

    // Envoi sans quitter la page. Sans JavaScript, le formulaire part quand même
    // vers Web3Forms, qui affiche sa propre page de confirmation.
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const success = document.querySelector<HTMLElement>('#contact-success');
    const error = document.querySelector<HTMLElement>('#contact-error');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      error?.classList.add('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.success === false) throw new Error(result.error ?? 'Échec de l’envoi');

        form.classList.add('hidden');
        success?.classList.remove('hidden');
        success?.focus();
        success?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      } catch {
        error?.classList.remove('hidden');
        error?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        if (button) button.disabled = false;
      }
    });
  </script>
</Layout>
