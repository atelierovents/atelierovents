---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection, getEntry } from 'astro:content';

const entry = await getEntry('pages', 'location');
const { title, tagline } = entry.data;
const { Content } = await entry.render();

// Un instrument loué reste au catalogue, avec son badge : la flotte bouge peu
// et le visiteur comprend qu'il peut se renseigner pour le suivant.
const instruments = (await getCollection('locations')).sort((a, b) => {
  const dispo = Number(b.data.disponible !== false) - Number(a.data.disponible !== false);
  return dispo !== 0 ? dispo : a.data.famille.localeCompare(b.data.famille);
});
const libres = instruments.filter((i) => i.data.disponible !== false).length;

const etapes = [
  { titre: 'Vous choisissez', texte: 'Un instrument de la liste ci-dessous, ou vous nous dites ce que vous cherchez.' },
  { titre: 'On prépare', texte: "L'instrument est réglé, nettoyé et vérifié à l'atelier avant chaque location." },
  { titre: 'Vous repartez', texte: "Avec l'instrument prêt à jouer, le contrat et l'état des lieux signés." },
];
---

<Layout title={title} description={tagline}>
  <PageHeader title={title} tagline={tagline} />

  <!-- Comment ça marche -->
  <section class="max-w-5xl mx-auto px-4 pb-14">
    <div class="grid gap-6 md:grid-cols-3">
      {etapes.map((etape, index) => (
        <div class="rounded-lg border border-stone-200 bg-white p-6">
          <span class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand text-sm font-semibold text-white">
            {index + 1}
          </span>
          <h2 class="text-lg font-semibold text-brand mb-2">{etape.titre}</h2>
          <p class="text-sm text-stone-600">{etape.texte}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Instruments disponibles -->
  <section class="max-w-5xl mx-auto px-4 pb-14">
    <h2 class="text-2xl font-semibold text-brand mb-1">Les instruments</h2>
    <p class="text-stone-600 mb-6">
      {libres === 0
        ? "Aucun instrument libre en ce moment."
        : libres === 1
          ? 'Un instrument disponible aujourd\'hui.'
          : `${libres} instruments disponibles aujourd\'hui.`}
      La liste évolue : n'hésitez pas à nous demander ce qui arrive.
    </p>

    {instruments.length === 0 ? (
      <p class="text-stone-500">Aucun instrument en location pour le moment.</p>
    ) : (
      <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-stone-200 text-xs uppercase tracking-wider text-stone-500">
            <tr>
              <th class="px-4 py-3 font-semibold">Instrument</th>
              <th class="px-4 py-3 font-semibold">Mensualité</th>
              <th class="hidden px-4 py-3 font-semibold sm:table-cell">Caution</th>
              <th class="hidden px-4 py-3 font-semibold sm:table-cell">État</th>
              <th class="px-4 py-3 font-semibold">Disponibilité</th>
            </tr>
          </thead>
          <tbody>
            {instruments.map((instrument) => {
              const { title: nom, famille, modele, mensualite, caution, etat, disponible } = instrument.data;
              const libre = disponible !== false;
              return (
                <tr class="border-b border-stone-100 last:border-0">
                  <td class="px-4 py-3">
                    <span class="font-semibold text-brand">{nom}</span>
                    {modele && <span class="block text-xs text-stone-500">{modele}</span>}
                    {famille !== nom && <span class="block text-xs text-stone-400">{famille}</span>}
                  </td>
                  <td class="px-4 py-3">{mensualite ? `${mensualite} € / mois` : <span class="text-stone-500">sur demande</span>}</td>
                  <td class="hidden px-4 py-3 sm:table-cell">{caution ? `${caution} €` : <span class="text-stone-500">—</span>}</td>
                  <td class="hidden px-4 py-3 text-stone-600 sm:table-cell">{etat ?? '—'}</td>
                  <td class="px-4 py-3">
                    <span class:list={[
                      'inline-block rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider',
                      libre ? 'bg-gold-50 text-gold-dark' : 'bg-stone-200 text-stone-600'
                    ]}>
                      {libre ? 'Disponible' : 'Loué'}
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}

    <a href="/contact" class="mt-8 inline-block rounded-lg bg-brand px-6 py-3 font-medium text-white transition hover:bg-brand-dark">
      Demander une location
    </a>
  </section>

  <!-- Conditions -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="prose max-w-3xl">
      <Content />
    </div>
  </section>
</Layout>
