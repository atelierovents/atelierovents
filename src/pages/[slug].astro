      <div class="grid grid-cols-3 gap-4 mb-8">
        {galerie.map((img) => (
          <img src={img} alt={title} class="w-full h-32 object-cover rounded-lg" />
        ))}
      </div>
    )}

    <h1 class="text-3xl font-bold mb-2">{title}</h1>
    {marque && <p class="text-stone-500 mb-4">{marque}</p>}

    <div class="flex items-center gap-4 mb-8">
