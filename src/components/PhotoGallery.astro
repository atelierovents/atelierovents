---
/**
 * Carrousel de photos d'une fiche instrument.
 *
 * Une seule photo → aucun contrôle, l'image seule. Plusieurs photos → flèches,
 * compteur, vignettes cliquables, clavier et balayage tactile. Sans JavaScript,
 * la première photo reste affichée : le contenu est lisible, seuls les
 * contrôles deviennent inertes.
 */
interface Photo {
  src: string;
  alt: string;
}

interface Props {
  photos: Photo[];
  label?: string;
}

const { photos, label = "Photos de l'instrument" } = Astro.props;
const hasControls = photos.length > 1;
---

<div class="mb-8" data-gallery role="group" aria-label={label} tabindex={hasControls ? 0 : undefined}>
  <div class="relative overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
    <div class="flex transition-transform duration-300 ease-out" data-track>
      {photos.map((photo, index) => (
        <div class="w-full min-w-0 shrink-0">
          <img
            src={photo.src}
            alt={photos.length > 1 ? `${photo.alt} — photo ${index + 1} sur ${photos.length}` : photo.alt}
            class="block aspect-[4/3] w-full object-contain"
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))}
    </div>

    {hasControls && (
      <>
        <button
          type="button"
          data-prev
          aria-label="Photo précédente"
          class="absolute left-2 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-stone-200 bg-white/90 text-2xl leading-none text-stone-700 shadow-sm transition hover:bg-white hover:text-amber-800"
        >
          ‹
        </button>
        <button
          type="button"
          data-next
          aria-label="Photo suivante"
          class="absolute right-2 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-stone-200 bg-white/90 text-2xl leading-none text-stone-700 shadow-sm transition hover:bg-white hover:text-amber-800"
        >
          ›
        </button>
        <p
          class="absolute bottom-3 right-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-stone-700 shadow-sm"
          data-counter
          aria-live="polite"
        >
          1 / {photos.length}
        </p>
      </>
    )}
  </div>

  {hasControls && (
    <>
      <div class="mt-3 grid grid-cols-5 gap-2 sm:grid-cols-6" data-thumbs>
        {photos.map((photo, index) => (
          <button
            type="button"
            data-thumb
            data-index={index}
            aria-label={`Voir la photo ${index + 1}`}
            aria-current={index === 0 ? 'true' : 'false'}
            class="overflow-hidden rounded border-2 border-stone-200 opacity-60 transition hover:opacity-100 aria-[current=true]:border-amber-700 aria-[current=true]:opacity-100"
          >
            <img src={photo.src} alt="" class="block h-14 w-full object-cover sm:h-16" decoding="async" />
          </button>
        ))}
      </div>
    </>
  )}
</div>

<script>
  const translate = (track: HTMLElement, index: number) => {
    track.style.transform = `translateX(-${index * 100}%)`;
  };

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;

    const total = track.children.length;
    if (total < 2) return;

    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    let index = 0;

    const render = () => {
      translate(track, index);
      thumbs.forEach((thumb, i) => {
        thumb.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
      if (counter) counter.textContent = `${index + 1} / ${total}`;
    };

    const go = (next: number) => {
      index = (next + total) % total;
      render();
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => go(Number(thumb.dataset.index)));
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(index + 1);
      }
    });

    let startX: number | null = null;
    root.addEventListener(
      'touchstart',
      (event) => {
        startX = event.touches[0]?.clientX ?? null;
      },
      { passive: true },
    );
    root.addEventListener(
      'touchend',
      (event) => {
        if (startX === null) return;
        const delta = (event.changedTouches[0]?.clientX ?? startX) - startX;
        if (Math.abs(delta) > 40) go(index + (delta < 0 ? 1 : -1));
        startX = null;
      },
      { passive: true },
    );

    render();
  });
</script>
