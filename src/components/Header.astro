---
import logo from '../assets/logo.svg';

const nav = [
  { label: 'Accueil', href: '/' },
  { label: 'Atelier', href: '/atelier' },
  { label: 'Occasions', href: '/occasions' },
  { label: 'Contact', href: '/contact' },
];
const current = Astro.url.pathname;

// Importé depuis src/assets : le build émet une URL hachée, mise en cache
// indéfiniment, et le logo suit le déploiement du site.
const logoSrc = logo.src;
---

<header class="bg-white border-b border-stone-200">
  <div class="max-w-5xl mx-auto px-4 pt-6 pb-4 sm:pt-8 flex flex-col items-center gap-4">
    <!-- Le logo porte le nom du site : son texte alternatif est donc le nom
         lui-même, et non une description décorative. -->
    <a href="/" class="block">
      <img
        src={logoSrc}
        alt="Atelier Ô Vents"
        width="160"
        height="160"
        class="h-28 w-auto sm:h-40"
      />
    </a>
    <nav aria-label="Navigation principale">
      <ul class="flex flex-wrap justify-center gap-x-5 gap-y-1 text-sm font-medium sm:gap-x-8 sm:text-base">
        {nav.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={[
                'hover:text-gold-dark transition-colors',
                current === href && 'text-gold-dark underline underline-offset-4'
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
