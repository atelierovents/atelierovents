---
/**
 * Bandeau de tête commun à toutes les pages : titre, sous-titre, puis une
 * phrase d'accroche optionnelle séparée par un filet doré.
 *
 * L'accroche peut courir sur plusieurs lignes : elle a sa propre mesure
 * (max-w-2xl), une interligne détendue et un équilibrage des lignes
 * (text-pretty) pour éviter les dernières lignes d'un seul mot.
 */
interface Props {
  title: string;
  subtitle?: string;
  tagline?: string;
  /** Variante plus resserrée, pour les pages de service. */
  compact?: boolean;
}

const { title, subtitle, tagline, compact = false } = Astro.props;
---

<section class:list={[compact ? 'py-14' : 'py-20']}>
  <div class="mx-auto max-w-3xl px-4 text-center">
    <h1 class="text-balance text-4xl font-semibold leading-tight text-brand sm:text-5xl">
      {title}
    </h1>

    {subtitle && (
      <p class="mx-auto mt-5 max-w-2xl text-pretty text-lg leading-relaxed text-stone-600">
        {subtitle}
      </p>
    )}

    {tagline && (
      <>
        <div class="mx-auto mt-7 h-px w-16 bg-gold"></div>
        <p class="mx-auto mt-7 max-w-2xl text-pretty text-base leading-relaxed text-stone-500">
          {tagline}
        </p>
      </>
    )}
  </div>
</section>
